{
  "name": "shitpostbot-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion-based reel renderer for ShitPostBot. Invoked by the Python orchestrator via `npx remotion render`.",
  "scripts": {
    "preview": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx Reel out/reel.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "@remotion/renderer": "4.0.500",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.500",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
